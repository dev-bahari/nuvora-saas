# Nuvora SaaS - Local Environment Configuration Example
# Copy this file to .env for local development

# Node environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=nuvora_app
POSTGRES_PASSWORD=nuvora_local_dev_password
POSTGRES_DB=nuvora_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=54321
DATABASE_URL=postgresql://nuvora_app:nuvora_local_dev_password@localhost:54321/nuvora_dev

# Storage (MinIO / S3 compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=nuvora-artifacts
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_local_dev_password
STORAGE_USE_SSL=false

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_32_byte_hex_secret_before_deploy
TEST_DATABASE_URL=postgresql://nuvora_app:nuvora_local_dev_password@localhost:54321/nuvora_test

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:3001
# 32 bytes hex; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIAN_SECRETS_KEY=
# UUID del único tenant autorizado para conexión directa durante el piloto.
DIAN_PILOT_TENANT_ID=
