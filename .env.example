# Nuvora SaaS - Local Environment Configuration Example
# Copy this file to .env for local development

# Node environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=nuvora_app
POSTGRES_PASSWORD=nuvora_local_dev_password
POSTGRES_DB=nuvora_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nuvora_app:nuvora_local_dev_password@localhost:5432/nuvora_dev

# Storage (MinIO / S3 compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=nuvora-artifacts
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_local_dev_password
STORAGE_USE_SSL=false

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:3001
