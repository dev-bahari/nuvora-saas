    "test:e2e": "echo \"api: e2e tests pending for Task 3\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nuvora/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
