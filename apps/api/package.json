{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build --path tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "pnpm --filter @nuvora/contracts --filter @nuvora/calculation-engine --filter @nuvora/invoice-view -r --if-present run build && pnpm --filter api build",
    "test": "vitest run",
    "test:integration": "echo \"api: integration tests pending for Task 2\"",
    "test:e2e": "echo \"api: e2e tests pending for Task 3\""
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nuvora/calculation-engine": "workspace:*",
    "@nuvora/contracts": "workspace:*",
    "@nuvora/invoice-view": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.7",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-crypto": "^6.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^22.13.9",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
